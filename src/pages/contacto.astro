---
import Layout from '../layouts/Layout.astro';
import UnifiedContactForm from '../components/UnifiedContactForm.astro';
import { MessageCircle, ShieldAlert, Calendar, Mail, BookMarked, HelpCircle, HeartHandshake, CheckCircle2 } from 'lucide-astro';
---

<Layout 
  title="Contacto, Sesiones y Lista del Libro | SaludConCiencia"
  description="Canal unificado de comunicación con Shirley Gaviria: solicita sesiones de orientación 1 a 1, únete a la lista de espera del libro o envía tus consultas sobre LMC."
>
  <div class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Contact Header (Heuristic #8: Aesthetic & Minimalist Design) -->
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-blue-soft text-brand-blue-600 text-xs font-bold uppercase tracking-wider">
          <MessageCircle class="w-3.5 h-3.5 text-brand-blue" />
          <span>Canal Único de Comunicación</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-brand-dark tracking-tight">
          Estamos aquí para escucharte y acompañarte
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-serif">
          Un punto de encuentro unificado para solicitar <strong>sesiones privadas 1 a 1</strong>, anotarte en la <strong>lista de espera del libro</strong> o enviar tus consultas sobre la leucemia mieloide crónica.
        </p>
      </div>

    </div>
  </div>

  <div class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Critical Medical Disclaimer Banner (Heuristic #5: Error Prevention) -->
      <div class="mb-12 p-6 rounded-3xl bg-amber-50 border-2 border-amber-200 shadow-sm flex flex-col md:flex-row items-start md:items-center gap-5">
        <div class="w-12 h-12 rounded-2xl bg-amber-200 text-amber-900 flex items-center justify-center shrink-0">
          <ShieldAlert class="w-6 h-6 text-amber-900" />
        </div>
        <div class="space-y-1">
          <h3 class="text-sm font-bold text-amber-950 uppercase tracking-wide">
            Aviso importante sobre urgencias y consultas médicas individuales
          </h3>
          <p class="text-xs text-amber-900 leading-relaxed">
            Este formulario es para <strong>orientación práctica, divulgación científica, lista del libro y apoyo</strong>. Shirley Gaviria no realiza diagnósticos individuales ni modifica prescripciones médicas. Ante cualquier síntoma agudo o urgencia médica, <strong>contacta de inmediato a tu hematólogo o acude a urgencias hospitalarias.</strong>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: The Unified Form (7 cols) -->
        <div class="lg:col-span-7">
          <UnifiedContactForm />
        </div>

        <!-- Right: Information & FAQ (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          
          <!-- Direct Services Card -->
          <div class="p-8 rounded-3xl bg-slate-900 text-white space-y-6 border border-neutral-800 shadow-xl">
            <div class="space-y-2">
              <span class="text-xs font-bold text-brand-lime uppercase tracking-wider">Acompañamiento Personalizado</span>
              <h3 class="text-xl font-extrabold text-white">Canales & Servicios</h3>
              <p class="text-xs text-neutral-300 leading-relaxed">
                Espacios 1 a 1 de orientación práctica, resolución de dudas del día a día y apoyo emocional.
              </p>
            </div>

            <div class="space-y-4 text-sm">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-neutral-800 text-slate-300 flex items-center justify-center shrink-0">
                  <Calendar class="w-5 h-5 text-slate-300" />
                </div>
                <div>
                  <div class="text-xs text-neutral-400">Sesiones privadas 1 a 1</div>
                  <div class="font-bold text-white">45 min por Zoom / Meet</div>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-neutral-800 text-slate-300 flex items-center justify-center shrink-0">
                  <Mail class="w-5 h-5 text-slate-300" />
                </div>
                <div>
                  <div class="text-xs text-neutral-400">Correo directo</div>
                  <div class="font-bold text-white">contacto@saludconciencia.org</div>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-neutral-800 text-slate-300 flex items-center justify-center shrink-0">
                  <BookMarked class="w-5 h-5 text-slate-300" />
                </div>
                <div>
                  <div class="text-xs text-neutral-400">Próximo libro</div>
                  <div class="font-bold text-white">Lista de espera activa</div>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-neutral-800 text-xs text-neutral-400 italic font-serif">
              "El acompañamiento de quien ya ha recorrido este camino disminuye el miedo y enciende la esperanza."
            </div>
          </div>

          <!-- Quick FAQ (Krug: Self-evident questions) -->
          <div class="p-6 rounded-3xl bg-slate-50 border border-slate-200 space-y-4">
            <h4 class="text-sm font-extrabold text-brand-dark flex items-center gap-2">
              <HelpCircle class="w-4 h-4 text-brand-blue" />
              <span>Preguntas Frecuentes</span>
            </h4>

            <div class="space-y-3 text-xs text-slate-700">
              <div class="space-y-1">
                <div class="font-bold text-slate-900">¿Cómo sé si mi mensaje fue recibido?</div>
                <p class="text-slate-600">Al presionar enviar, recibirás confirmación visual inmediata y un correo de confirmación de parte de Shirley.</p>
              </div>

              <div class="space-y-1">
                <div class="font-bold text-slate-900">¿Puedo pedir una sesión para un familiar?</div>
                <p class="text-slate-600">Por supuesto. Muchos familiares y cuidadores asisten a las sesiones para aprender a acompañar mejor a sus seres queridos.</p>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</Layout>
