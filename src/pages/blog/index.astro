---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { BookOpen, Search, Clock, Calendar, ArrowRight, User, Tag, Sparkles } from 'lucide-astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find(post => post.data.featured) || sortedPosts[0];
const regularPosts = sortedPosts.filter(post => post.id !== featuredPost?.id);

const categories = [
  'Todos',
  'Diagnóstico',
  'Tratamientos e ITKs',
  'Vida Cotidiana',
  'Embarazo y Fertilidad',
  'Salud Mental',
  'Nutrición y Mitos'
];
---

<Layout 
  title="Blog y Guías de Divulgación | SaludConCiencia"
  description="Artículos, guías y testimonios sobre Leucemia Mieloide Crónica explicados por Shirley Gaviria, bacterióloga y paciente desde hace más de 22 años."
>
  <div class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Blog Header (Heuristic #8: Aesthetic & Minimalist Design) -->
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-blue-soft text-brand-blue-600 text-xs font-bold uppercase tracking-wider">
          <BookOpen class="w-3.5 h-3.5" />
          <span>Biblioteca de Divulgación</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-brand-dark tracking-tight">
          Artículos, Ciencia y Experiencia en LMC
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-serif">
          Respuestas fundamentadas en la evidencia médica más actualizada y enriquecidas con más de dos décadas de vivencia real.
        </p>
      </div>

      <!-- Category Filter Tabs (Heuristic #7: Flexibility and Efficiency) -->
      <div class="flex items-center gap-2 overflow-x-auto pt-8 pb-2 no-scrollbar" id="blog-category-filter">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`category-tab-btn px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap transition-all duration-200 ${
              idx === 0 
                ? 'bg-brand-dark text-white shadow-md' 
                : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

    </div>
  </div>

  <div class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Featured Post Highlight -->
      {featuredPost && (
        <section class="featured-post-container">
          <div class="rounded-3xl bg-slate-900 text-white overflow-hidden shadow-2xl border border-neutral-800 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <div class="lg:col-span-7 h-72 lg:h-[420px] relative overflow-hidden">
              <img 
                src={featuredPost.data.image} 
                alt={featuredPost.data.imageAlt} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-4 left-4">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-extrabold bg-brand-lime text-brand-dark shadow-md">
                  <Sparkles class="w-3.5 h-3.5 text-brand-dark" />
                  <span>Artículo Destacado</span>
                </span>
              </div>
            </div>

            <div class="lg:col-span-5 p-6 sm:p-10 space-y-6">
              <div class="space-y-2">
                <div class="flex items-center gap-3 text-xs text-neutral-400">
                  <span class="text-brand-blue font-bold">{featuredPost.data.category}</span>
                  <span>·</span>
                  <span>{featuredPost.data.readingTime}</span>
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-white leading-snug hover:text-brand-lime transition-colors">
                  <a href={`/blog/${featuredPost.id}/`}>
                    {featuredPost.data.title}
                  </a>
                </h2>

                <p class="text-sm text-neutral-300 leading-relaxed line-clamp-3">
                  {featuredPost.data.description}
                </p>
              </div>

              <!-- Author Info -->
              <div class="flex items-center justify-between pt-4 border-t border-neutral-800">
                <div class="flex items-center gap-3">
                  <img 
                    src={featuredPost.data.authorAvatar} 
                    alt={featuredPost.data.author} 
                    class="w-10 h-10 rounded-full object-cover border border-brand-lime"
                  />
                  <div>
                    <div class="text-xs font-bold text-white">{featuredPost.data.author}</div>
                    <div class="text-[10px] text-neutral-400">{featuredPost.data.authorRole}</div>
                  </div>
                </div>

                <a 
                  href={`/blog/${featuredPost.id}/`} 
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-lime text-brand-dark font-extrabold text-xs hover:bg-white transition-colors"
                >
                  <span>Leer</span>
                  <ArrowRight class="w-3.5 h-3.5" />
                </a>
              </div>

            </div>

          </div>
        </section>
      )}

      <!-- All Articles Grid -->
      <section>
        <div class="flex items-center justify-between mb-8">
          <h3 class="text-xl font-extrabold text-brand-dark">Todos los Artículos</h3>
          <span class="text-xs text-slate-500 font-medium" id="post-count-label">
            Mostrando {sortedPosts.length} publicaciones
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="posts-grid">
          {sortedPosts.map((post) => (
            <article 
              class="post-card rounded-3xl bg-white border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl hover:border-brand-blue/40 transition-all duration-300 flex flex-col justify-between group"
              data-category={post.data.category}
            >
              <div>
                <div class="relative h-52 overflow-hidden bg-slate-100">
                  <img 
                    src={post.data.image} 
                    alt={post.data.imageAlt} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute top-4 left-4">
                    <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-white/90 backdrop-blur-md text-slate-800 shadow-sm">
                      {post.data.category}
                    </span>
                  </div>
                </div>

                <div class="p-6 space-y-3">
                  <div class="flex items-center gap-3 text-xs text-slate-500 font-medium">
                    <span class="flex items-center gap-1">
                      <Calendar class="w-3.5 h-3.5 text-slate-400" />
                      {new Date(post.data.pubDate).toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                      <Clock class="w-3.5 h-3.5 text-slate-400" />
                      {post.data.readingTime}
                    </span>
                  </div>

                  <h4 class="text-lg font-extrabold text-brand-dark group-hover:text-brand-blue transition-colors line-clamp-2 leading-snug">
                    <a href={`/blog/${post.id}/`}>
                      {post.data.title}
                    </a>
                  </h4>

                  <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
              </div>

              <!-- Card Footer -->
              <div class="px-6 pb-6 pt-3 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <img 
                    src={post.data.authorAvatar} 
                    alt={post.data.author} 
                    class="w-7 h-7 rounded-full object-cover"
                  />
                  <span class="text-xs font-semibold text-slate-700">{post.data.author}</span>
                </div>
                
                <a 
                  href={`/blog/${post.id}/`} 
                  class="text-xs font-bold text-brand-dark group-hover:text-brand-blue flex items-center gap-1"
                >
                  <span>Leer</span>
                  <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.category-tab-btn');
    const postCards = document.querySelectorAll('.post-card');
    const countLabel = document.getElementById('post-count-label');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        filterButtons.forEach(b => {
          b.classList.remove('bg-brand-dark', 'text-white', 'shadow-md');
          b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        });

        btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        btn.classList.add('bg-brand-dark', 'text-white', 'shadow-md');

        let visibleCount = 0;
        postCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'Todos' || cardCat === cat) {
            // @ts-ignore
            card.style.display = 'flex';
            visibleCount++;
          } else {
            // @ts-ignore
            card.style.display = 'none';
          }
        });

        if (countLabel) {
          countLabel.textContent = `Mostrando ${visibleCount} publicaciones`;
        }
      });
    });
  });
</script>
