---
import { Heart, ShieldCheck, Mail, ArrowUpRight, BookOpen, ExternalLink, MapPin, Pill, FlaskConical, Users, BookMarked, HeartHandshake, Home, Newspaper, MessageCircle } from 'lucide-astro';
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-brand-dark text-white relative overflow-hidden pt-20 pb-12 border-t border-neutral-800">
  <!-- Glowing Background Accents from Palette -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-brand-blue/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-brand-lime/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Medical Disclaimer Banner (Heuristic #5: Error Prevention & Transparency) -->
    <div class="mb-16 p-6 rounded-3xl bg-neutral-900/90 border border-neutral-800 shadow-xl flex flex-col md:flex-row items-start md:items-center gap-5">
      <div class="w-12 h-12 rounded-2xl bg-brand-blue/20 flex items-center justify-center shrink-0 border border-brand-blue/30 text-brand-blue">
        <ShieldCheck class="w-6 h-6 text-brand-blue" />
      </div>
      <div class="space-y-1">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
          <span>Aviso de Responsabilidad Médica y Ética</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] bg-brand-blue/20 text-brand-blue border border-brand-blue/30">Divulgación Científica</span>
        </h4>
        <p class="text-xs text-neutral-400 leading-relaxed">
          El propósito de <strong>SaludConCiencia</strong> es exclusivamente educativo y de divulgación científica basada en evidencia y vivencia testimonial. <strong>Esta plataforma no reemplaza la consulta, diagnóstico o indicación de tu médico especialista en Hematología.</strong> Nunca modifiques ni suspendas tu tratamiento sin supervisión facultativa.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-white text-brand-dark flex items-center justify-center font-extrabold text-lg shadow-md">
            S<span class="text-brand-blue">C</span>
          </div>
          <div>
            <span class="text-xl font-extrabold tracking-tight text-white flex items-center gap-1">
              Salud<span class="text-brand-blue">Con</span>Ciencia
            </span>
            <span class="text-xs text-neutral-400 block">La biblioteca viva de Leucemia Mieloide Crónica</span>
          </div>
        </div>

        <p class="text-sm text-neutral-400 leading-relaxed">
          Un espacio creado por <strong>Shirley Gaviria</strong> (Bacterióloga, Especialista en Gerencia en Salud y paciente de LMC desde hace más de 22 años) para transformar la incertidumbre en conocimiento, autonomía y esperanza.
        </p>

        <!-- Social Media Dynamic Links -->
        <div class="space-y-2 pt-1">
          <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Síguenos en redes:</div>
          <SocialLinks />
        </div>

        <div class="flex items-center gap-2 text-xs text-brand-lime font-semibold pt-2">
          <span class="w-2 h-2 rounded-full bg-brand-lime animate-pulse"></span>
          <span>"Detrás de un diagnóstico también existe una vida llena de esperanza."</span>
        </div>
      </div>

      <!-- Navigation Column (Monochromatic Icons) -->
      <div class="space-y-4">
        <h5 class="text-xs font-bold text-white uppercase tracking-widest text-neutral-300">Explorar</h5>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <Home class="w-3.5 h-3.5 text-neutral-400" />
              <span>Inicio</span>
            </a>
          </li>
          <li>
            <a href="/#modulos" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <BookOpen class="w-3.5 h-3.5 text-neutral-400" />
              <span>Biblioteca de Módulos</span>
            </a>
          </li>
          <li>
            <a href="/#libro" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <BookMarked class="w-3.5 h-3.5 text-neutral-400" />
              <span>El Libro (Lista de Espera)</span>
            </a>
          </li>
          <li>
            <a href="/#orientacion" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <HeartHandshake class="w-3.5 h-3.5 text-neutral-400" />
              <span>Sesiones 1 a 1</span>
            </a>
          </li>
          <li>
            <a href="/blog" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <Newspaper class="w-3.5 h-3.5 text-neutral-400" />
              <span>Blog & Artículos</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Rutas Rápidas Column -->
      <div class="space-y-4">
        <h5 class="text-xs font-bold text-white uppercase tracking-widest text-neutral-300">Rutas de Paciente</h5>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/#ruta" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <MapPin class="w-3.5 h-3.5 text-neutral-400" />
              <span>Recién Diagnosticado</span>
            </a>
          </li>
          <li>
            <a href="/#ruta" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <Pill class="w-3.5 h-3.5 text-neutral-400" />
              <span>Inicio de Tratamiento</span>
            </a>
          </li>
          <li>
            <a href="/#ruta" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <Heart class="w-3.5 h-3.5 text-neutral-400" />
              <span>Embarazo y LMC</span>
            </a>
          </li>
          <li>
            <a href="/#ruta" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <FlaskConical class="w-3.5 h-3.5 text-neutral-400" />
              <span>Exámenes (PCR, Cariotipo)</span>
            </a>
          </li>
          <li>
            <a href="/#ruta" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
              <Users class="w-3.5 h-3.5 text-neutral-400" />
              <span>Familiares y Cuidadores</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Column (Completely clean of CMS text) -->
      <div class="space-y-4">
        <h5 class="text-xs font-bold text-white uppercase tracking-widest text-neutral-300">Contacto Directo</h5>
        <div class="space-y-3 text-sm">
          <a href="https://wa.me/34613491695" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-colors w-full justify-center shadow-md">
            <MessageCircle class="w-4 h-4 fill-white" />
            <span>WhatsApp (+34 613491695)</span>
          </a>
          <div class="p-3 rounded-xl bg-neutral-900 border border-neutral-800 text-[11px] text-neutral-400 space-y-1">
            <div class="text-white font-bold">Atención personalizada</div>
            <p>Acompañamiento cálido y respetuoso de paciente a paciente.</p>
          </div>
        </div>
        <p class="text-[11px] text-neutral-500">
          Diseñado con rigor científico, empatía humana y heurísticas de usabilidad.
        </p>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-neutral-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400">
      <p>© 2026 SaludConCiencia · Shirley Gaviria. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="/contacto" class="hover:text-white transition-colors">Preguntas frecuentes</a>
        <a href="/contacto" class="hover:text-white transition-colors">Privacidad y ética</a>
        <span class="text-neutral-600">·</span>
        <span class="text-slate-400 flex items-center gap-1">
          Hecho con <Heart class="w-3.5 h-3.5 text-rose-500 fill-rose-500 inline" /> para la comunidad de LMC
        </span>
      </div>
    </div>

  </div>
</footer>
