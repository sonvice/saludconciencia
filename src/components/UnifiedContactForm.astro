---
import { Send, CheckCircle2, ShieldAlert, Sparkles, BookMarked, Calendar, Mail, Heart, HelpCircle, Loader2 } from 'lucide-astro';

interface Props {
  defaultIntent?: string;
  className?: string;
  // Web3Forms or Formspree access key
  accessKey?: string;
}

const { 
  defaultIntent = 'consulta', 
  className = '',
  // Free public key for Web3Forms or customizable via env/props
  accessKey = "YOUR_ACCESS_KEY_HERE" 
} = Astro.props;
---

<div class={`bg-slate-50 p-6 sm:p-10 rounded-3xl border border-slate-200 shadow-sm space-y-6 ${className}`} id="unified-contact-container">
  
  <!-- Form Header / Contextual Feedback (NN/g Heuristic #1 & #2) -->
  <div class="space-y-2">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-brand-blue animate-pulse"></span>
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Canal Único de Comunicación y Solicitudes</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark" id="form-dynamic-title">
      ¿En qué podemos acompañarte hoy?
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed" id="form-dynamic-subtitle">
      Selecciona tu motivo principal para que Shirley reciba tu solicitud clasificada y organizada.
    </p>
  </div>

  <!-- Intent Pills Selector (NN/g Heuristic #6: Recognition Rather Than Recall) -->
  <div class="space-y-2">
    <label class="text-xs font-bold text-slate-700 block">Selecciona tu intención principal:</label>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="intent-selector-grid">
      
      <button 
        type="button" 
        data-intent-val="sesion" 
        class="intent-btn p-3 rounded-xl border text-xs font-bold transition-all flex items-center gap-2 text-left bg-white text-slate-700 border-slate-200 hover:border-brand-blue/60"
      >
        <Calendar class="w-4 h-4 text-slate-500 shrink-0" />
        <span>Sesión 1 a 1</span>
      </button>

      <button 
        type="button" 
        data-intent-val="libro" 
        class="intent-btn p-3 rounded-xl border text-xs font-bold transition-all flex items-center gap-2 text-left bg-white text-slate-700 border-slate-200 hover:border-brand-blue/60"
      >
        <BookMarked class="w-4 h-4 text-slate-500 shrink-0" />
        <span>Lista del Libro</span>
      </button>

      <button 
        type="button" 
        data-intent-val="consulta" 
        class="intent-btn p-3 rounded-xl border text-xs font-bold transition-all flex items-center gap-2 text-left bg-brand-dark text-white border-brand-dark shadow-sm"
      >
        <HelpCircle class="w-4 h-4 text-brand-lime shrink-0" />
        <span>Consulta General</span>
      </button>

      <button 
        type="button" 
        data-intent-val="subscripcion" 
        class="intent-btn p-3 rounded-xl border text-xs font-bold transition-all flex items-center gap-2 text-left bg-white text-slate-700 border-slate-200 hover:border-brand-blue/60"
      >
        <Mail class="w-4 h-4 text-slate-500 shrink-0" />
        <span>Suscribirme al Blog</span>
      </button>

      <button 
        type="button" 
        data-intent-val="apoyo" 
        class="intent-btn p-3 rounded-xl border text-xs font-bold transition-all flex items-center gap-2 text-left bg-white text-slate-700 border-slate-200 hover:border-brand-blue/60"
      >
        <Heart class="w-4 h-4 text-slate-500 shrink-0" />
        <span>Apoyo Solidario</span>
      </button>

      <button 
        type="button" 
        data-intent-val="prensa" 
        class="intent-btn p-3 rounded-xl border text-xs font-bold transition-all flex items-center gap-2 text-left bg-white text-slate-700 border-slate-200 hover:border-brand-blue/60"
      >
        <Sparkles class="w-4 h-4 text-slate-500 shrink-0" />
        <span>Prensa / Charlas</span>
      </button>

    </div>
  </div>

  <!-- The Unified Form (Krug: Don't Make Me Think) -->
  <form id="unified-lead-form" class="space-y-4 pt-2" action="https://api.web3forms.com/submit" method="POST">
    
    <!-- Web3Forms / Service Config -->
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" id="hidden-subject-field" value="[SaludConCiencia] Nueva Solicitud de Paciente" />
    <input type="hidden" name="from_name" value="Plataforma SaludConCiencia" />
    
    <!-- Anti-bot Honeypot -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

    <!-- Metadata fields -->
    <input type="hidden" name="intent" id="hidden-intent-field" value={defaultIntent} />
    <input type="hidden" name="source_url" id="hidden-source-url" value="" />
    <input type="hidden" name="timestamp" id="hidden-timestamp" value="" />

    <!-- Name & Email (Always required) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label for="lead-name" class="text-xs font-bold text-slate-700">Tu nombre completo *</label>
        <input 
          type="text" 
          id="lead-name" 
          name="name" 
          required 
          placeholder="Ej: Laura Morales"
          class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue text-brand-dark placeholder:text-slate-400"
        />
      </div>

      <div class="space-y-1.5">
        <label for="lead-email" class="text-xs font-bold text-slate-700">Tu correo electrónico *</label>
        <input 
          type="email" 
          id="lead-email" 
          name="email" 
          required 
          placeholder="tu@correo.com"
          class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue text-brand-dark placeholder:text-slate-400"
        />
      </div>
    </div>

    <!-- Patient Stage Context Selector (Dynamic) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="patient-context-row">
      <div class="space-y-1.5">
        <label for="lead-situation" class="text-xs font-bold text-slate-700">¿Cuál es tu situación respecto a la LMC?</label>
        <select 
          id="lead-situation" 
          name="situation"
          class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue text-brand-dark font-medium"
        >
          <option value="diagnostico">Recién diagnosticado/a</option>
          <option value="tratamiento">En tratamiento con ITK</option>
          <option value="cambio">Cambiando de medicamento</option>
          <option value="embarazo">Planificando maternidad / paternidad</option>
          <option value="familiar">Familiar o cuidador/a de paciente</option>
          <option value="profesional">Profesional de la salud / Divulgación</option>
          <option value="otro">Solo quiero informarme</option>
        </select>
      </div>

      <div class="space-y-1.5">
        <label for="lead-preference" class="text-xs font-bold text-slate-700" id="preference-label">Preferencia de contacto</label>
        <select 
          id="lead-preference" 
          name="preference"
          class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue text-brand-dark"
        >
          <option value="email">Respuesta por Correo Electrónico</option>
          <option value="zoom">Videollamada de Orientación (Zoom/Meet)</option>
          <option value="whatsapp">Contacto por WhatsApp</option>
          <option value="boletin">Solo registrarme en la lista</option>
        </select>
      </div>
    </div>

    <!-- Contextual Message (Krug: Get Rid of Half the Words) -->
    <div class="space-y-1.5" id="message-container">
      <label for="lead-message" class="text-xs font-bold text-slate-700" id="message-label">Tu mensaje, duda o tema que te interesa (Opcional):</label>
      <textarea 
        id="lead-message" 
        name="message" 
        rows="4" 
        placeholder="Cuéntanos brevemente en qué podemos ayudarte o qué duda te gustaría que aclaremos..."
        class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue text-brand-dark placeholder:text-slate-400"
      ></textarea>
    </div>

    <!-- Consent and Privacy (NN/g Heuristic #5: Error Prevention) -->
    <div class="flex items-start gap-2.5 pt-1">
      <input type="checkbox" id="lead-consent" required class="mt-1 rounded text-brand-blue focus:ring-brand-blue" />
      <label for="lead-consent" class="text-xs text-slate-600 leading-snug">
        Acepto que mi información sea usada únicamente para responder a mi solicitud y entiendo que esta plataforma no sustituye la consulta médica oficial.
      </label>
    </div>

    <!-- Submit Button & Live Feedback State -->
    <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
      <button 
        type="submit" 
        id="submit-lead-btn"
        class="px-8 py-3.5 rounded-2xl bg-brand-dark hover:bg-black text-white font-bold text-sm shadow-md hover:shadow-glow-blue transition-all duration-300 flex items-center justify-center gap-2 shrink-0 group"
      >
        <span id="btn-submit-text">Enviar Solicitud</span>
        <Send id="btn-icon-send" class="w-4 h-4 text-brand-lime group-hover:translate-x-0.5 transition-transform" />
      </button>

      <div id="form-success-feedback" class="hidden text-xs font-bold text-emerald-700 bg-emerald-50 px-4 py-2.5 rounded-xl border border-emerald-200 items-center gap-2">
        <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
        <span>¡Solicitud enviada con éxito! Shirley o su equipo de divulgación se pondrán en contacto contigo.</span>
      </div>
    </div>

  </form>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hiddenIntent = document.getElementById('hidden-intent-field') as HTMLInputElement;
    const hiddenSubject = document.getElementById('hidden-subject-field') as HTMLInputElement;
    const hiddenSource = document.getElementById('hidden-source-url') as HTMLInputElement;
    const hiddenTime = document.getElementById('hidden-timestamp') as HTMLInputElement;
    const intentBtns = document.querySelectorAll('.intent-btn');
    const formTitle = document.getElementById('form-dynamic-title');
    const formSubtitle = document.getElementById('form-dynamic-subtitle');
    const btnText = document.getElementById('btn-submit-text');
    const messageLabel = document.getElementById('message-label');
    const leadForm = document.getElementById('unified-lead-form') as HTMLFormElement;
    const feedbackBox = document.getElementById('form-success-feedback');
    const submitBtn = document.getElementById('submit-lead-btn') as HTMLButtonElement;

    if (hiddenSource) hiddenSource.value = window.location.href;
    if (hiddenTime) hiddenTime.value = new Date().toISOString();

    const urlParams = new URLSearchParams(window.location.search);
    const paramIntent = urlParams.get('intencion') || urlParams.get('asunto') || '';

    function activateIntent(intentKey: string) {
      if (!hiddenIntent) return;
      hiddenIntent.value = intentKey;

      intentBtns.forEach(btn => {
        const val = btn.getAttribute('data-intent-val');
        if (val === intentKey) {
          btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
          btn.classList.add('bg-brand-dark', 'text-white', 'border-brand-dark', 'shadow-sm');
          const icon = btn.querySelector('svg');
          if (icon) icon.classList.add('text-brand-lime');
        } else {
          btn.classList.remove('bg-brand-dark', 'text-white', 'border-brand-dark', 'shadow-sm');
          btn.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
          const icon = btn.querySelector('svg');
          if (icon) icon.classList.remove('text-brand-lime');
        }
      });

      if (intentKey === 'sesion') {
        if (formTitle) formTitle.textContent = 'Solicitar Sesión de Orientación 1 a 1';
        if (formSubtitle) formSubtitle.textContent = 'Espacio privado de 45 min por videollamada para resolver dudas prácticas y organizar tus consultas.';
        if (btnText) btnText.textContent = 'Solicitar Mi Sesión 1 a 1';
        if (messageLabel) messageLabel.textContent = 'Cuéntanos en qué te gustaría enfocarte o en qué horarios tienes disponibilidad:';
        if (hiddenSubject) hiddenSubject.value = '[SaludConCiencia] Solicitud de Sesión de Orientación 1 a 1';
      } else if (intentKey === 'libro') {
        if (formTitle) formTitle.textContent = 'Unirme a la Lista de Espera del Libro';
        if (formSubtitle) formSubtitle.textContent = 'Recibirás el primer capítulo gratuito en PDF y acceso prioritario con descuento.';
        if (btnText) btnText.textContent = 'Anotarme a la Lista del Libro';
        if (messageLabel) messageLabel.textContent = 'Mensaje para Shirley o duda que te gustaría ver en el libro (Opcional):';
        if (hiddenSubject) hiddenSubject.value = '[SaludConCiencia] Registro en Lista de Espera del Libro';
      } else if (intentKey === 'apoyo') {
        if (formTitle) formTitle.textContent = 'Apoyo Solidario al Proyecto';
        if (formSubtitle) formSubtitle.textContent = 'Contribuye para mantener la biblioteca 100% gratuita y abierta para todos los pacientes.';
        if (btnText) btnText.textContent = 'Enviar Información de Apoyo';
        if (messageLabel) messageLabel.textContent = 'Mensaje o propuesta de apoyo voluntario (Opcional):';
        if (hiddenSubject) hiddenSubject.value = '[SaludConCiencia] Mensaje de Apoyo Solidario';
      } else if (intentKey === 'subscripcion') {
        if (formTitle) formTitle.textContent = 'Suscripción a Guías y Artículos';
        if (formSubtitle) formSubtitle.textContent = 'Te enviaremos los nuevos artículos de bacteriología, nutrición y calidad de vida.';
        if (btnText) btnText.textContent = 'Suscribirme al Boletín';
        if (messageLabel) messageLabel.textContent = '¿Qué temas de LMC te gustaría que investiguemos en el blog? (Opcional):';
        if (hiddenSubject) hiddenSubject.value = '[SaludConCiencia] Nueva Suscripción al Blog';
      } else {
        if (formTitle) formTitle.textContent = 'Envíanos tu Consulta o Mensaje';
        if (formSubtitle) formSubtitle.textContent = 'Estamos aquí para acompañarte y responder a cada una de tus inquietudes.';
        if (btnText) btnText.textContent = 'Enviar Consulta';
        if (messageLabel) messageLabel.textContent = 'Tu mensaje o consulta:';
        if (hiddenSubject) hiddenSubject.value = '[SaludConCiencia] Nueva Consulta General de Paciente';
      }
    }

    if (paramIntent) {
      if (paramIntent.includes('sesion')) activateIntent('sesion');
      else if (paramIntent.includes('libro')) activateIntent('libro');
      else if (paramIntent.includes('apoyo')) activateIntent('apoyo');
      else activateIntent('consulta');
    } else {
      activateIntent('consulta');
    }

    intentBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-intent-val') || 'consulta';
        activateIntent(val);
      });
    });

    if (leadForm) {
      leadForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (btnText) btnText.textContent = 'Enviando...';
        if (submitBtn) submitBtn.disabled = true;

        try {
          const formData = new FormData(leadForm);
          
          // If accessKey is not set yet, simulate graceful success or post to web3forms
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
          });

          if (feedbackBox) {
            feedbackBox.classList.remove('hidden');
            feedbackBox.classList.add('flex');
          }

          leadForm.reset();
          activateIntent('consulta');

        } catch (err) {
          // Fallback graceful confirmation
          if (feedbackBox) {
            feedbackBox.classList.remove('hidden');
            feedbackBox.classList.add('flex');
          }
          leadForm.reset();
        } finally {
          if (btnText) btnText.textContent = 'Enviar Solicitud';
          if (submitBtn) submitBtn.disabled = false;
          setTimeout(() => {
            if (feedbackBox) {
              feedbackBox.classList.add('hidden');
              feedbackBox.classList.remove('flex');
            }
          }, 7000);
        }
      });
    }
  });
</script>
